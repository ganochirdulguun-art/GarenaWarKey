<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- for the notification-area icon -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LexusWarKey</AssemblyName>
    <Product>Garena.mn WarKey</Product>
    <AssemblyTitle>Garena.mn WarKey</AssemblyTitle>
    <Company>Garena.mn</Company>
    <RootNamespace>LexusWarKey</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" Condition="Exists('Assets\logo.png')" />
  </ItemGroup>

  <!-- The LoD ability table (id -> letter, name, command-card position). Embedded so the app
       can recognise abilities in war3's memory without shipping a loose data file. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\lod_ability_table.csv" />
  </ItemGroup>

  <!-- WinForms is referenced only for the tray icon; its global usings would otherwise
       collide with WPF on Application, Point, KeyEventArgs and friends. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- DPAPI: the stored Discord session token is encrypted per Windows user. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
