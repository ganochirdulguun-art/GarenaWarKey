<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="LexusWarKey"/>

  <!-- Always run elevated. Reading/writing Warcraft's memory (the skill layer) needs the app to be
       at least Warcraft's integrity level, and WC3 1.26a on modern Windows is commonly launched
       elevated (compatibility, GameRanger). Self-elevating means a single UAC prompt on launch instead
       of the player having to right-click -> Run as administrator every time. A higher-integrity app
       can still read/write and send input to a normal-launched war3 (the restriction is the other way
       round), so this works whether the game is elevated or not. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- requireAdministrator (2026-09-03 буцаав): WC3 ихэвчлэн админ эрхээр ажилладаг тул skill уншихад админ эрх заавал.
             Платформд шигтгэх туршилт (v2.7.0 asInvoker) буцаагдсан; embedded код идэвхгүй үлдэнэ. -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
