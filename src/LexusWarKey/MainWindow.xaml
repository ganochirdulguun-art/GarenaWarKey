<Window x:Class="LexusWarKey.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LexusWarKey.ViewModels"
        Title="Garena.mn WarKey" Width="600" Height="520" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Skill slot: just the player's key. The letter is resolved live in-game, so there is
             nothing else to set here. Empty slots fade back; set slots light up blue. -->
        <DataTemplate x:Key="SkillTile">
            <Border x:Name="Tile" Width="60" Height="52" Margin="3" CornerRadius="8"
                    Background="#15171B" BorderBrush="#262931" BorderThickness="1.5">
                <Grid Margin="4,2,4,2">
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource B.Dim}" FontSize="9"
                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <Button x:Name="From" Style="{StaticResource TileFrom}" Content="{Binding FromDisplay}"
                            Command="{Binding CaptureFromCommand}"
                            ToolTip="The letter this skill slot will use in-game. Click, then press a letter. Backspace clears." />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSet}" Value="False">
                    <Setter TargetName="From" Property="Opacity" Value="0.30" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSet}" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="#122340" />
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource B.Blue}" />
                </DataTrigger>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource B.Blue}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Inventory slot: your key on top, the game key it sends below. Both are set here. -->
        <DataTemplate x:Key="InventoryTile">
            <Border x:Name="Tile" Width="60" Height="56" Margin="3" CornerRadius="8"
                    Background="#15171B" BorderBrush="#262931" BorderThickness="1.5">
                <Grid Margin="4,2,4,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="14" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Label}" Foreground="{StaticResource B.Dim}"
                               FontSize="9" HorizontalAlignment="Left" />
                    <TextBlock x:Name="Check" Grid.Row="0" Text="&#x2713;" Foreground="{StaticResource B.Ok}"
                               FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top"
                               Visibility="Collapsed" ToolTip="Ready" />
                    <Button x:Name="From" Grid.Row="1" Style="{StaticResource TileFrom}" Content="{Binding FromDisplay}"
                            Command="{Binding CaptureFromCommand}"
                            ToolTip="Your key. Click, then press it. Backspace clears." />
                    <Button Grid.Row="2" Style="{StaticResource TileTo}" Content="{Binding ToDisplay}"
                            Command="{Binding CaptureToCommand}"
                            ToolTip="The item slot's game key this sends. Click, then press it." />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSet}" Value="False">
                    <Setter TargetName="From" Property="Opacity" Value="0.30" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSet}" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="#122340" />
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource B.Blue}" />
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource B.Blue}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- A slow rainbow sweep around the app frame — the overlay's look, calmer. -->
                    <DoubleAnimation Storyboard.TargetName="AppBorderRotate" Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:9" RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border BorderThickness="2" CornerRadius="11" Background="#DE0B0C10">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <LinearGradientBrush.RelativeTransform>
                    <RotateTransform x:Name="AppBorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#FF3B3B" Offset="0.0" />
                <GradientStop Color="#FFB13B" Offset="0.16" />
                <GradientStop Color="#F5F53B" Offset="0.33" />
                <GradientStop Color="#3BFF6A" Offset="0.5" />
                <GradientStop Color="#3BC8FF" Offset="0.66" />
                <GradientStop Color="#9A5BFF" Offset="0.83" />
                <GradientStop Color="#FF3B3B" Offset="1.0" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <!-- Fixed-size window, so a fixed rounded clip trims the content to the frame's corners. -->
        <Border.Clip>
            <RectangleGeometry Rect="0,0,600,520" RadiusX="11" RadiusY="11" />
        </Border.Clip>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#B00C0D11" Padding="22,14" MouseLeftButtonDown="Header_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource B.Dim}" FontSize="13"
                               VerticalAlignment="Center" />

                    <!-- Update: auto-checks on startup; click to check now, or restart into a
                         downloaded version (turns green when one is ready). -->
                    <Button Command="{Binding UpdateCommand}" Cursor="Hand" Background="Transparent"
                            BorderThickness="0" Padding="0" Margin="12,0,0,0" VerticalAlignment="Center"
                            ToolTip="Шинэчлэлт шалгах / суулгах">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding UpdateGlyph}" FontSize="14" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource B.Dim}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateReady}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource B.Ok}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding UpdateStatus}" FontSize="11" VerticalAlignment="Center"
                                       Margin="6,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource B.Dim}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateReady}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource B.Ok}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Open the in-game skill/inventory overlay (same as Ctrl+F6). -->
                    <Button Command="{Binding ToggleOverlayCommand}" Cursor="Hand" Margin="16,0,0,0"
                            VerticalAlignment="Center" ToolTip="Тоглоом дээрх тохиргооны цонх">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ob" CornerRadius="8" Padding="11,6" BorderThickness="1"
                                        Background="#141E30" BorderBrush="#294066">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x25A3;" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{StaticResource B.Blue}" />
                                        <TextBlock Text="Overlay" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource B.Text}" />
                                        <Border Background="#1E2A40" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Ctrl+F6" FontSize="9.5" Foreground="{StaticResource B.Dim}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ob" Property="Background" Value="#1C3055" />
                                        <Setter TargetName="ob" Property="BorderBrush" Value="{StaticResource B.Blue}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Signed-in Discord account + log out -->
                <Border CornerRadius="20" Padding="12,6" Margin="0,0,10,0" Background="#12FFFFFF"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasAccount, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource B.Blue}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AccountName}" Foreground="{StaticResource B.Text}" FontSize="12"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                                   MaxWidth="140" TextTrimming="CharacterEllipsis" />
                        <Button Content="⏻" Command="{Binding LogoutCommand}" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource B.Dim}"
                                FontSize="15" Margin="10,0,0,0" Padding="2,0,0,0" VerticalAlignment="Center"
                                ToolTip="Discord-оос гарах" />
                    </StackPanel>
                </Border>

                <Border CornerRadius="20" Padding="14,8" VerticalAlignment="Center"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#2A2724" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsLive}" Value="True">
                                    <Setter Property="Background" Value="#23332A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource B.Dim}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsLive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource B.Ok}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource B.Dim}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,1,0,0" MaxWidth="190"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Custom window caption (the OS title bar is hidden). -->
                <Button Style="{StaticResource CaptionButton}" Content="&#x2013;" Margin="14,0,0,0"
                        Click="Minimize_Click" ToolTip="Багасгах" />
                <Button Style="{StaticResource CaptionClose}" Content="&#x2715;" Margin="2,0,0,0"
                        Click="Close_Click" ToolTip="Хаах (tray руу)" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,16,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="8" Background="{StaticResource B.RedDim}" BorderBrush="{StaticResource B.Red}"
                    BorderThickness="1" Padding="14,11" Margin="0,0,0,12"
                    Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Attention" Foreground="{StaticResource B.Red}"
                               FontWeight="Bold" FontSize="13" />
                    <TextBlock Text="{Binding ProblemText}" Foreground="{StaticResource B.Text}" FontSize="12"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TabControl Grid.Row="1">
                <TabItem Header="Warkey">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Hotkeys" Margin="2,0,2,10" />

                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PanelTitle}" Text="Inventory" />
                                        <ItemsControl ItemsSource="{Binding InventoryRows}" ItemTemplate="{StaticResource InventoryTile}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="12,10" VerticalAlignment="Top" Width="320">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PanelTitle}" Text="Skills" />

                                        <Grid Margin="6,0,4,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="22" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Skill" Foreground="{StaticResource B.Dim}" FontSize="10" />
                                            <TextBlock Grid.Column="1" Text="Default" Foreground="{StaticResource B.Dim}" FontSize="10" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Your key" Foreground="{StaticResource B.Dim}" FontSize="10" HorizontalAlignment="Center" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding DetectedSkills}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#15171B" BorderBrush="#242730" BorderThickness="1"
                                                            CornerRadius="5" Margin="0,0,0,3" Padding="8,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="52" />
                                                                <ColumnDefinition Width="52" />
                                                                <ColumnDefinition Width="22" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource B.Text}"
                                                                       FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Default}" Foreground="{StaticResource B.Dim}"
                                                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Button Grid.Column="2" Style="{StaticResource CellChip}" Content="{Binding AssignedDisplay}"
                                                                    Padding="4,2" Command="{Binding AssignCommand}"
                                                                    ToolTip="Click, then press the letter you want this skill on. Backspace clears." />

                                                            <!-- Status: pulsing dot while the writer is applying, green tick once the
                                                                 game's card reads back your letter. -->
                                                            <Grid Grid.Column="3">
                                                                <Ellipse x:Name="Pulse" Width="9" Height="9" Fill="#E6A23C"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                         Visibility="Collapsed"
                                                                         ToolTip="Applying your letter in-game..." />
                                                                <TextBlock x:Name="Check" Text="&#x2713;" Foreground="{StaticResource B.Ok}"
                                                                           FontSize="13" FontWeight="Bold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Visibility="Collapsed" ToolTip="Active in-game" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsApplying}" Value="True">
                                                            <Setter TargetName="Pulse" Property="Visibility" Value="Visible" />
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="PulseSb">
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="Pulse"
                                                                                         Storyboard.TargetProperty="Opacity"
                                                                                         From="1" To="0.2" Duration="0:0:0.6"
                                                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="PulseSb" />
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding SkillsHint}" Margin="2,4,2,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDetectedSkills}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="QuickChat">
                    <DockPanel>
                        <!-- Add bar: pick a key, type a message, Нэмэх (or Enter). The key stays so you
                             can add several messages to the same key quickly. -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource KeyCapChip}" Content="{Binding NewHotkeyDisplay}"
                                        MinWidth="66" Height="34" Command="{Binding CaptureNewHotkeyCommand}" ToolTip="Товч сонгох" />
                                <TextBox Grid.Column="1" Margin="8,0" Padding="8,5" FontFamily="Consolas"
                                         VerticalContentAlignment="Center" MaxLines="1"
                                         Text="{Binding NewMessage, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding AddChatEntryCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="2" Command="{Binding AddChatEntryCommand}" Cursor="Hand"
                                        Height="34" ToolTip="Мессеж нэмэх (Enter)">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ab" CornerRadius="8" Padding="18,0" MinWidth="104">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#5A8CFF" Offset="0" />
                                                        <GradientStop Color="#3B6FE0" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="+" FontSize="17" FontWeight="Bold" Foreground="White"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="Нэмэх" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                                               Margin="7,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ab" Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#6E9BFF" Offset="0" />
                                                                <GradientStop Color="#4A7EF0" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="ab" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#5A8CFF" Opacity="0.7" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ab" Property="Background" Value="#345FC0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <Grid DockPanel.Dock="Top" Margin="0,4,10,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ТОВЧ" Foreground="{StaticResource B.Dim}" FontSize="10"
                                       FontWeight="SemiBold" Margin="13,0,0,0" />
                            <TextBlock Grid.Column="1" Text="МЕССЕЖ" Foreground="{StaticResource B.Dim}" FontSize="10"
                                       FontWeight="SemiBold" Margin="12,0,0,0" />
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <ItemsControl ItemsSource="{Binding ChatEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="row" BorderBrush="#242833" BorderThickness="1"
                                                CornerRadius="8" Margin="0,0,0,5">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#171A21" Offset="0" />
                                                    <GradientStop Color="#12141A" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid Height="42">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left accent bar (lights up on hover / focus) -->
                                                <Border x:Name="accent" Grid.Column="0" Background="Transparent"
                                                        CornerRadius="8,0,0,8" />

                                                <Button Grid.Column="1" Style="{StaticResource KeyCapChip}" MinWidth="50"
                                                        Margin="9,0,0,0" Content="{Binding HotkeyDisplay}"
                                                        Command="{Binding CaptureCommand}" ToolTip="Товч солих" />
                                                <TextBox x:Name="msg" Grid.Column="2" Margin="12,0,6,0" Padding="0"
                                                         FontFamily="Consolas" FontSize="13.5"
                                                         VerticalContentAlignment="Center" MaxLines="1"
                                                         BorderThickness="0" Background="Transparent"
                                                         Foreground="{StaticResource B.Text}"
                                                         Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button x:Name="del" Grid.Column="3" Style="{StaticResource CaptionButton}"
                                                        Content="&#x2715;" Opacity="0.25" Margin="0,0,6,0"
                                                        Command="{Binding RemoveCommand}" ToolTip="Устгах" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="row" Property="BorderBrush" Value="#37445F" />
                                                <Setter TargetName="accent" Property="Background" Value="{StaticResource B.Blue}" />
                                                <Setter TargetName="del" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <Trigger SourceName="msg" Property="IsFocused" Value="True">
                                                <Setter TargetName="accent" Property="Background" Value="{StaticResource B.Blue}" />
                                                <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource B.Blue}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.RowSpan="2" Background="#B0000000" Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="34,26">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Товч эсвэл хулгана дар" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Text="Scroll ↑↓ ба хажуугийн товчнууд бас болно&#x0a;Esc — болих · Backspace — арилгах" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
    </Border>
</Window>
